# ── Supabase ─────────────────────────────────────────────
# Leeg laten = de app draait in "lokale modus" (data in de browser).
# Invullen = login + opslag in Supabase (zie README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL van je site (voor e-mail-links en RSVP-links), bv. https://jouw-app.vercel.app
# Alleen invullen met je echte adres (bijv. https://jullie-domein.nl); laat leeg op Vercel.
NEXT_PUBLIC_SITE_URL=

# ── fal.ai ───────────────────────────────────────────────
# Alleen server-side gebruikt, nooit naar de browser gestuurd.
FAL_KEY=
# Optioneel: modellen overschrijven
FAL_LLM_MODEL=google/gemini-2.5-flash
FAL_IMAGE_MODEL=fal-ai/flux/schnell
